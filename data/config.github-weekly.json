{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.25,
    "max_tokens": 8192,
    "languages": [
      "zh"
    ],
    "throttle_sec": 0
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 0,
      "min_score": 0
    },
    "rss": [
      {
        "name": "GitHub Trending - Weekly All",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/weekly/all.xml",
        "enabled": true,
        "category": "github-trending-weekly"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 0,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 0,
      "max_tweets_to_expand": 0,
      "reply_min_likes": 0
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 168
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": null,
    "headers": ""
  }
}
