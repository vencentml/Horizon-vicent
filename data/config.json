    "reddit": {
      "enabled": true,
      "subreddits": [
        {"subreddit": "MachineLearning", "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 40, "min_score": 30},
        {"subreddit": "LocalLLaMA", "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 40, "min_score": 30},
        {"subreddit": "ExperiencedDevs", "enabled": true, "sort": "top", "time_filter": "day", "fetch_limit": 30, "min_score": 50},
